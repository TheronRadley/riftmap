# Riftmap is developed with LF line endings. Normalising on checkout keeps the
# shell scripts runnable on Windows CI runners (a CRLF checkout makes /bin/bash
# choke on the carriage returns) and keeps Zig and TypeScript sources byte
# identical across platforms.
* text=auto eol=lf

*.sh   text eol=lf
*.zig  text eol=lf
*.zon  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.mjs  text eol=lf
*.py   text eol=lf

*.png binary
*.jpg binary
*.ico binary
