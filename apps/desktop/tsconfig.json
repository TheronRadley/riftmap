{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@riftmap/shared": ["../../packages/shared/src/index.ts"],
      "@riftmap/git-analysis": ["../../packages/git-analysis/src/index.ts"],
      "@riftmap/analysis": ["../../packages/analysis/src/index.ts"]
    }
  },
  "include": ["src/**/*", "shared/**/*", "electron/**/*"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/git-analysis" },
    { "path": "../../packages/analysis" }
  ]
}
